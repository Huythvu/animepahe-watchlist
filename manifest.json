{
  "manifest_version": 3,
  "name": "Animepahe Watchlist",
  "key": "",
  "version": "1.7.0",
  "description": "Adds a Currently Watching and Plan to Watch list to Animepahe.",
  "permissions": ["storage", "tabs", "identity"],
  "host_permissions": [
    "https://animepahe.pw/*",
    "https://kwik.cx/*",
    "https://graphql.anilist.co/*",
    "https://myanimelist.net/*",
    "https://api.myanimelist.net/*",
    "https://firestore.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://animepahe.pw/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://kwik.cx/*"],
      "js": ["player.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": ["https://animepahe.pw/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}